#!/usr/bin/env python3
# smol: a tiny terminal front end for the 3,156-byte engine.
# The engine binary is not changed; this script only runs it and draws the screen.
#   SMOL_BIN   engine binary   (default: bin/final next to this script)
#   SMOL_DIR   model folder    (default: ~/smol)
import os, re, sys, time, subprocess, threading
try:
    import readline  # arrow keys + history at the prompt
except ImportError:
    pass

HERE = os.path.dirname(os.path.realpath(__file__))
BIN = os.environ.get("SMOL_BIN", os.path.join(HERE, "bin", "final"))
DIR = os.path.expanduser(os.environ.get("SMOL_DIR", "~/smol"))
DIM, BOLD, ORANGE, RESET = "\033[2m", "\033[1m", "\033[38;5;209m", "\033[0m"


def banner():
    size = os.path.getsize(BIN)
    lines = [f"{ORANGE}✻{RESET} {BOLD}smol{RESET}",
             "",
             f"{DIM}engine  {RESET}{size:,} bytes of C",
             f"{DIM}model   {RESET}SmolLM2-135M, unmodified safetensors",
             f"{DIM}decode  {RESET}greedy, matches HF transformers token for token"]
    width = 58
    print(f"{ORANGE}╭{'─' * width}╮{RESET}")
    for l in lines:
        pad = width - 1 - len(re.sub(r"\033\[[0-9;]*m", "", l))
        print(f"{ORANGE}│{RESET} {l}{' ' * pad}{ORANGE}│{RESET}")
    print(f"{ORANGE}╰{'─' * width}╯{RESET}")
    print(f"{DIM}  type text and it keeps writing · \\n for a newline · /n 60 sets tokens · /q quits{RESET}\n")


def spinner(stop):
    frames = "✻✶✳✢·✢✳✶"
    i = 0
    while not stop.is_set():
        sys.stdout.write(f"\r{ORANGE}{frames[i % len(frames)]}{RESET} {DIM}thinking…{RESET}")
        sys.stdout.flush()
        i += 1
        stop.wait(0.12)
    sys.stdout.write("\r\033[K")


def run(prompt, n):
    t0 = time.time()
    p = subprocess.Popen([BIN, prompt, str(n)], cwd=DIR, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL)
    skip = len(prompt.encode())  # the engine echoes the prompt first; we print it ourselves
    stop = threading.Event()
    th = threading.Thread(target=spinner, args=(stop,))
    th.start()
    EOT, held, ended = b"<|endoftext|>", b"", False
    try:
        while b := p.stdout.read1(64):
            k = min(skip, len(b))
            skip, b = skip - k, b[k:]
            if not b:
                continue
            if not stop.is_set():  # first generated byte: swap the spinner for the text
                stop.set(); th.join()
                sys.stdout.write(DIM + prompt + RESET); sys.stdout.flush()
            held += b
            if EOT in held:  # the model says the text is over: stop there
                sys.stdout.buffer.write(held[:held.index(EOT)])
                p.kill()
                ended = True
                break
            cut = len(held) - len(EOT) + 1  # keep back what could be the start of EOT
            sys.stdout.buffer.write(held[:max(cut, 0)])
            held = held[max(cut, 0):]
            sys.stdout.flush()
        if not ended:
            sys.stdout.buffer.write(held)
    except KeyboardInterrupt:
        p.kill()
        sys.stdout.write(f"\n{DIM}  stopped{RESET}")
    stop.set(); th.join()
    p.wait()
    dt = time.time() - t0
    if ended:
        print(f"\n{DIM}  end of text · {dt:.1f}s{RESET}\n")
    else:
        print(f"\n{DIM}  {n} tokens · {dt:.1f}s · {n / dt:.1f} tok/s{RESET}\n")


def main():
    if not os.path.exists(os.path.join(DIR, "model.safetensors")):
        sys.exit(f"no model.safetensors in {DIR} (set SMOL_DIR)")
    n = 60
    if len(sys.argv) > 1:  # one-shot: smol "The cat sat"
        return run(" ".join(sys.argv[1:]), n)
    banner()
    while True:
        try:
            line = input(f"{BOLD}>{RESET} ")
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not line.strip():
            continue
        if line in ("/q", "/quit", "/exit"):
            return
        if line.startswith("/n"):
            n = int(line.split()[1])
            print(f"{DIM}  {n} tokens per run{RESET}\n")
            continue
        line = line.replace("\\n", "\n")  # type \n for a newline
        run(line, n)


if __name__ == "__main__":
    main()
